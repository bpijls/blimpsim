# Lives on the GPU host next to docker-compose.yml. deploy.sh never overwrites it.

# Required — must match SIM_SECRET in the api's .env. Never commit a real value.
SIM_SECRET=

# Address and port the gateway is published on. Prefer the host's LAN/VPN
# address over 0.0.0.0 when the host is reachable from outside.
GATEWAY_BIND_ADDR=0.0.0.0
GATEWAY_PORT=8100
