# ── Public hostnames (Caddy Docker Proxy) ────────────────────────────────────
APP_DOMAIN=blimpsim.paws.home
API_DOMAIN=api.blimpsim.paws.home
CADDY_NETWORK=proxy

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=app
DB_PASSWORD=changeme
DB_NAME=blimpsim
DATABASE_URL=postgresql+asyncpg://app:changeme@postgres:5432/blimpsim

# ── Simulator (Godot + gateway on the GPU host) ──────────────────────────────
# Required — shared secret between the api and the gateway. The api refuses to
# start without it. Never commit a real value.
SIM_SECRET=
SIM_GATEWAY_URL=http://vonk:8100
# Which blimp the api steers: sim (the digital twin) or real (the hardware; not implemented yet).
BLIMP_DRIVER=sim
# Used by sim/deploy.sh only: where to rsync and run the simulator.
SIM_HOST=vonk
SIM_REMOTE_DIR=projects/blimpsim-sim

# ── Local access without Caddy ───────────────────────────────────────────────
# Uncomment here and in docker-compose.yml to bind a host port.
# HOST_PORT=8000
